# Supabase project used to store contact form submissions
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Email alert for new enquiries (Google Workspace account + App Password)
SMTP_USER=hr@stagitysolutions.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Optional: where alerts go (defaults to SMTP_USER)
NOTIFY_TO=hr@stagitysolutions.com

# ---- HR portal / remote Form I-9 (/hr) ----
# Supabase secret key (Project Settings → API Keys → Secret key). Server-only.
SUPABASE_SECRET_KEY=sb_secret_xxx
# 32 random bytes, base64:  openssl rand -base64 32   (never change it once records exist)
I9_ENCRYPTION_KEY=
# Random string, 32+ characters:  openssl rand -hex 32
I9_SESSION_SECRET=
# Comma-separated HR emails allowed to sign in
HR_EMAILS=hr@stagitysolutions.com
# Random string; Vercel sends it to /api/cron/reminders (daily timesheet reminders)
CRON_SECRET=
# Optional: who gets "timesheet submitted" emails with the attachment (comma-separated). Defaults to HR_EMAILS.
ACCOUNTS_EMAILS=
